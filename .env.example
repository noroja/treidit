# KINETIC — variáveis de ambiente (NUNCA commitar o .env real)
# ------------------------------------------------------------
# Provedor de IA priorizado: Groq → Gemini → (sem chave = stubs locais).

# GROQ (recomendada): chave gratuita e permanente, sem cartão
# 1) console.groq.com/api/keys → Create API Key
# 2) cole a chave aqui; o backend a usa sozinho (nunca vai ao navegador)
# Modelo default do tier gratuito 2026: openai/gpt-oss-120b
# (30 req/min · 1.000 req/dia · 200K tokens/dia; veja console.groq.com/docs/models)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# GEMINI (fallback opcional): chave gratuita em aistudio.google.com/apikey
GEMINI_API_KEY=

# Porta do servidor (dev usa 5178 com Vite middleware)
PORT=5178
